# ==== App ====
# Pais usado cuando no se puede geolocalizar (middleware x-vercel-ip-country).
# En desarrollo pon tu pais para probar la paridad de precios (CO, MX, US, ES...).
NEXT_PUBLIC_DEFAULT_COUNTRY=CO

# URL publica del sitio (para redirect_url de pagos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Analytics (opcional) ====
# Crea un proyecto gratis en PostHog y pega la API key de tipo "Web".
# Sin esta key, los eventos se loguean por consola en desarrollo.
NEXT_PUBLIC_POSTHOG_KEY=

# ==== Captura de leads (intencion de verificacion) ====
# Crea un formulario gratis en https://formspree.io y pega el ID (ej: "xyzabcde").
# Los clics en "Limpiar y verificar" te llegaran ahi como leads.
NEXT_PUBLIC_FORMSPREE_ID=
# Alternativa: un webhook (Zapier/Make/Google Sheets) para /api/lead.
LEAD_WEBHOOK_URL=
# Notificacion por email de cada lead (Resend: https://resend.com, gratis hasta 3k/mes).
# Con RESEND_API_KEY, cada lead se envia por email a LEAD_TO_EMAIL.
RESEND_API_KEY=
LEAD_TO_EMAIL=info@pdf2emails.com
LEAD_FROM_EMAIL=info@pdf2emails.com

# ==== Verificacion de emails (opcional, server-only) ====
# Sin ninguna API, la verificacion cae a MX + lista de desechables. Con cualquiera
# de estas obtienes verificacion SMTP real (mejor precision). Se usa la primera disponible.
QEV_API_KEY=
REOON_API_KEY=
ZEROBOUNCE_API_KEY=
ABSTRACT_API_KEY=

# ==== Enriquecimiento (server-only) ====
# Se usa para el upsell de "Enriquecer con Nombres y Cargos".
OPENAI_API_KEY=

# ==== Comprobante de pago (server-only) ====
# Firma los tokens que /api/paypal/capture y /api/dlocal/verify emiten SOLO tras
# confirmar un pago real, y que /api/process exige para hacer verificacion/
# enriquecimiento (que cuestan dinero real de terceros). Pon un valor random
# largo en produccion — sin esto, cae a PAYPAL_CLIENT_SECRET/DLOCAL_SECRET_KEY
# como fallback, que funciona pero es menos prolijo.
PAYMENT_TOKEN_SECRET=

# ==== Pagos PayPal (opcional) ====
# Sin estas variables el checkout corre en MODO DEMO (pago simulado).
# Credenciales de una app REST creada en https://developer.paypal.com/dashboard/applications
# (usa la misma cuenta Business de PayPal con la que ya cobras en miCANTERA).
# El Client Secret NUNCA va al cliente: las llamadas a PayPal son server-side.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Client ID PUBLICO (el mismo valor de arriba): lo usa el SDK JS en el navegador
# para dibujar los botones embebidos de PayPal y, sobre todo, el boton de
# "Tarjeta de debito o credito" que abre el formulario de tarjeta SIN pedir
# login. Sin esta variable el checkout de PayPal usa el flujo de redireccion
# (que en esta cuenta arranca en la pantalla de login).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# "sandbox" (por defecto) o "live" para cobrar dinero real.
PAYPAL_ENV=sandbox
# ID del webhook (dashboard de PayPal -> Webhooks). Eventos a suscribir:
# CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED.
# Sin este ID el webhook solo registra el evento en los logs y no captura nada.
PAYPAL_WEBHOOK_ID=

# ==== dLocal Go (para cobros reales en LATAM: PSE, Pix, OXXO, tarjetas locales) ====
# Keys desde https://dashboard.dlocalgo.com (live) o https://dashboard-sbx.dlocalgo.com (sandbox)
# en Integrations -> API Integration. NUNCA exponer la Secret Key al cliente.
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
# "sbx" (sandbox) por defecto | "live" para produccion
DLOCAL_ENV=sbx
