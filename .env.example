# ==== App ====
# Pais usado cuando no se puede geolocalizar (middleware x-vercel-ip-country).
# En desarrollo pon tu pais para probar la paridad de precios (CO, MX, US, ES...).
NEXT_PUBLIC_DEFAULT_COUNTRY=CO

# URL publica del sitio (para redirect_url de pagos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Analytics (opcional) ====
# Crea un proyecto gratis en PostHog y pega la API key de tipo "Web".
# Sin esta key, los eventos se loguean por consola en desarrollo.
NEXT_PUBLIC_POSTHOG_KEY=

# ==== Captura de leads (intencion de verificacion) ====
# Crea un formulario gratis en https://formspree.io y pega el ID (ej: "xyzabcde").
# Los clics en "Limpiar y verificar" te llegaran ahi como leads.
NEXT_PUBLIC_FORMSPREE_ID=
# Alternativa: un webhook (Zapier/Make/Google Sheets) para /api/lead.
LEAD_WEBHOOK_URL=
# Notificacion por email de cada lead (Resend: https://resend.com, gratis hasta 3k/mes).
# Con RESEND_API_KEY, cada lead se envia por email a LEAD_TO_EMAIL.
RESEND_API_KEY=
LEAD_TO_EMAIL=info@pdf2emails.com
LEAD_FROM_EMAIL=info@pdf2emails.com

# ==== Verificacion de emails (opcional, server-only) ====
# Sin ninguna API, la verificacion cae a MX + lista de desechables. Con cualquiera
# de estas obtienes verificacion SMTP real (mejor precision). Se usa la primera disponible.
QEV_API_KEY=
REOON_API_KEY=
ZEROBOUNCE_API_KEY=
ABSTRACT_API_KEY=

# ==== Enriquecimiento (server-only) ====
# Se usa para el upsell de "Enriquecer con Nombres y Cargos".
OPENAI_API_KEY=

# ==== Pagos Wompi (opcional) ====
# Sin estas variables el checkout corre en MODO DEMO (pago simulado).
# Public key va al frontend; private e integrity keys solo al servidor.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=

# ==== dLocal Go (para cobros reales en LATAM: PSE, Pix, OXXO, tarjetas locales) ====
# Keys desde https://dashboard.dlocalgo.com (live) o https://dashboard-sbx.dlocalgo.com (sandbox)
# en Integrations -> API Integration. NUNCA exponer la Secret Key al cliente.
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
# "sbx" (sandbox) por defecto | "live" para produccion
DLOCAL_ENV=sbx
