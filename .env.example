# ==== App ====
# Pais usado cuando no se puede geolocalizar (middleware x-vercel-ip-country).
# En desarrollo pon tu pais para probar la paridad de precios (CO, MX, US, ES...).
NEXT_PUBLIC_DEFAULT_COUNTRY=CO

# URL publica del sitio (para redirect_url de pagos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Analytics (opcional) ====
# Crea un proyecto gratis en PostHog y pega la API key de tipo "Web".
# Sin esta key, los eventos se loguean por consola en desarrollo.
NEXT_PUBLIC_POSTHOG_KEY=

# ==== Pagos Wompi (opcional) ====
# Sin estas variables el checkout corre en MODO DEMO (pago simulado).
# Public key va al frontend; private e integrity keys solo al servidor.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=

# ==== dLocal Go (proximo paso) ====
# DLOCAL_X_LOGIN=
# DLOCAL_X_TRANS_KEY=
